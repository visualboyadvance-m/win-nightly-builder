[Unit]
Description=Run the VBAM vcpkg Daily Upgrade daily at 09:00

[Timer]
# Staggered with the Android upgrade and the nightly so that none of the three
# is still running when the next one starts. The longest this one has taken is
# 3h20m (09-11), so it gets the 09:00-13:00 slot; vbam-vcpkg-daily-android
# takes 13:00-22:00 and vbam-nightly-android starts at 23:00.
OnCalendar=*-*-* 09:00:00

[Install]
WantedBy=timers.target
